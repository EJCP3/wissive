{
  "name": "wissive",
  "version": "0.1.1",
  "description": "Librería de emojis interactivos con expresiones vivas",
  "homepage": "https://wissive-docs.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/EJCP3/wissive.git"
  },
  "bugs": {
    "url": "https://github.com/EJCP3/wissive/issues"
  },
  "type": "module",
  "main": "./dist/wissive.cjs",
  "module": "./dist/wissive.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/wissive.js",
      "require": "./dist/wissive.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./astro": "./src/astro/Wissive.astro"
  },
  "files": [
    "dist",
    "src/astro"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc && vite build && vite build --config vite.umd.config.ts",
    "check:spring": "node --experimental-strip-types src/core/spring.check.ts",
    "check:state": "node --experimental-strip-types src/core/state.check.ts",
    "check:benchmark": "node --experimental-strip-types src/core/benchmark.check.ts",
    "check:motion": "node --experimental-strip-types src/core/motion.check.ts",
    "check:sequence": "node --experimental-strip-types src/core/sequence.check.ts",
    "check:particles": "node --experimental-strip-types src/render/particles.check.ts",
    "check:accessories": "node --experimental-strip-types src/render/accessories.check.ts",
    "check:knot": "node --experimental-strip-types src/render/knot.check.ts",
    "check:custom": "node --experimental-strip-types src/emojis/custom.check.ts",
    "check:listeners": "node --experimental-strip-types src/events/listeners.check.ts",
    "sheet": "node --experimental-strip-types scripts/contact-sheet.ts",
    "check": "pnpm run check:spring && pnpm run check:state && pnpm run check:benchmark && pnpm run check:motion && pnpm run check:sequence && pnpm run check:particles && pnpm run check:accessories && pnpm run check:knot && pnpm run check:custom && pnpm run check:listeners && tsc --noEmit",
    "preview": "vite preview"
  },
  "keywords": [
    "emoji",
    "animation",
    "spring-physics",
    "interactive",
    "svg",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.2.18",
    "astro": "^7.2.2",
    "react": "^19.2.8",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0",
    "vue": "^3.5.41"
  },
  "peerDependencies": {
    "astro": "*",
    "cuelume": "*",
    "react": "*",
    "vue": "*"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "cuelume": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
