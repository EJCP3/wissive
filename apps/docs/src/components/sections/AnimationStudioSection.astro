---
import AnimationStudio from '../studio/AnimationStudio.vue';
---

<section id="estudio-animacion" class="doc-section" style="max-width: 100%; width: 100%; padding: 0;">
  <div style="margin-bottom: 1.5rem;">
    <h2>Studio de Animación</h2>
    <p style="color: var(--text-sub); margin-top: 0.25rem;">
      Compón tus propias animaciones a partir de los diseños, expresiones y estados. Arrastra el cabezal para previsualizar en tiempo real y exporta el montaje.
    </p>
  </div>

  <div style="width: 100%;">
    <AnimationStudio client:load />
  </div>
</section>
