---
import CodeBlock from '../CodeBlock.astro';
---

<section id="personalizado" class="doc-section">
  <h2>Tu propio emoji</h2>
  <p>
    Base círculo, rasgos a elección: ojos, boca, personalidad, partículas y sonido de
    cualquiera de los 14, mezclados como quieras.
  </p>

  <div class="toolbar-wrapper" id="custom-panel-wrapper" style="position: static;">
    <div class="toolbar">
      <div class="toolbar-group">
        <button class="btn" id="btn-randomize" type="button">Aleatorio</button>
        <button class="btn" id="btn-custom-gaze" type="button">Seguir Ratón</button>
      </div>
      <div class="toolbar-group">
        <span class="toolbar-label">Color:</span>
        <input type="color" id="custom-color" value="#C9DCD3" style="width: 2.2rem; height: 2.2rem; border: none; border-radius: 10px; cursor: pointer;" />
      </div>
      <div class="toolbar-group">
        <span class="toolbar-label">Forma:</span>
        <select id="custom-shape" class="btn" style="padding: 0.3rem 0.6rem;"></select>
      </div>
      <div class="toolbar-group">
        <span class="toolbar-label">Ojos de:</span>
        <select id="custom-eyes" class="btn" style="padding: 0.3rem 0.6rem;"></select>
      </div>
      <div class="toolbar-group">
        <span class="toolbar-label">Boca de:</span>
        <select id="custom-mouth" class="btn" style="padding: 0.3rem 0.6rem;"></select>
      </div>
      <div class="toolbar-group">
        <span class="toolbar-label">Personalidad de:</span>
        <select id="custom-motion" class="btn" style="padding: 0.3rem 0.6rem;"></select>
      </div>
      <div class="toolbar-group">
        <span class="toolbar-label">Partículas de:</span>
        <select id="custom-particles" class="btn" style="padding: 0.3rem 0.6rem;"></select>
      </div>
      <div class="toolbar-group">
        <span class="toolbar-label">Sonido de:</span>
        <select id="custom-sound" class="btn" style="padding: 0.3rem 0.6rem;"></select>
      </div>
      <div class="toolbar-group">
        <span class="toolbar-label">Tamaño:</span>
        <div id="custom-size-picker">
          <button type="button" class="state-chip" data-size="xs">XS</button>
          <button type="button" class="state-chip" data-size="sm">SM</button>
          <button type="button" class="state-chip active" data-size="base">Base</button>
          <button type="button" class="state-chip" data-size="lg">LG</button>
          <button type="button" class="state-chip" data-size="xl">XL</button>
          <button type="button" class="state-chip" data-size="2xl">2XL</button>
        </div>
      </div>
    </div>
    <div class="toolbar" style="margin-top: 0.6rem; flex-direction: column; align-items: stretch; gap: 0.6rem;">
      <span class="toolbar-label">Banco de animaciones — qué visita solo en reposo:</span>
      <div id="custom-state-bank" style="display: flex; flex-wrap: wrap; gap: 0.4rem;"></div>
    </div>
  </div>

  <div class="grid" id="custom-emoji-grid" style="max-width: 200px; margin: 1.5rem auto 0;"></div>

  <p style="margin-top: 2rem;">Tu configuración, lista para copiar:</p>
  <div class="fw-picker" id="custom-fw-picker">
    <button class="btn active" data-fw="vanilla" type="button">Vanilla</button>
    <button class="btn" data-fw="react" type="button">React</button>
    <button class="btn" data-fw="vue" type="button">Vue</button>
    <button class="btn" data-fw="astro" type="button">Astro</button>
  </div>
  <CodeBlock id="custom-config-block" codeId="custom-config-code" />
</section>
