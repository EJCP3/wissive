{
  "name": "wissive",
  "version": "0.1.0",
  "description": "Micro-librería de JavaScript/TypeScript de emojis vivos reactivos con física de resorte",
  "type": "module",
  "main": "./dist/wissive.cjs",
  "module": "./dist/wissive.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/wissive.js",
      "require": "./dist/wissive.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite app",
    "app": "vite app",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "emoji",
    "animation",
    "spring-physics",
    "interactive",
    "svg",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0"
  },
  "peerDependencies": {
    "cuelume": "*"
  },
  "peerDependenciesMeta": {
    "cuelume": {
      "optional": true
    }
  }
}
